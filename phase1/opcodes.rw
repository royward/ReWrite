// 1: 3 bit: tttSSSab0xx
const OpPlus=0;
const OpMinus=1;
const OpTimes=2;
const OpShiftLeft=3;

// 2: 5 bit: zabSSS0x1xx
const OpLt=4;
const OpLte=5;
const OpCompLtBr=6;
const OpCompLteBr=7;
const OpShiftRight=12;
const OpDiv=13;
const OpMod=14;
const OpReserved5_1=15; // future use

// 8 bit: (var)XXX1x1xx (all the rest, except singletons, XXX cannot all be 1)
// 3: Other sized operations: +SSS00000000 or +ss00000000
const OpStore=20; // +a
const OpLoad=22; // class 4
const OpTrunc=23; // class 4
const OpUnaryMinus=30; // +a
const OpBitNot=52; // +a

// 7: unsized unary: +a
const OpMove=28; // +a
const OpNot=54; // +a

// 5: E: unsized binary: + a0000000b
const OpEqual=84;
const OpNotEqual=86;
const OpCompEqBr=92;
const OpCompNeqBr=94;
const OpAnd=116;
const OpOr=118;
const OpXor=124;

// D: Misc
const OpSext=60; // + destination ss, class 6

const OpZext=126; // Moved to handcode because it is a nop

const OpLabel=224;
const OpCall=225;
const OpRet=226;
const OpGoto=227;
const OpLea=229;
const OpLeaScale=230;

const OpError=254;
const OpCallIO=255;

const OpAlloc=736;
const OpReallocFixed=737;
const OpReallocVar=738;
const OpEmptyList=739;
const OpDerefFree=740;
const OpDerefFreeList=741;
const OpIncMem=742;
const OpCont=743;

const OpPrependImm=744;
const OpPrependReg=745;
const OpAppendImm=746;
const OpAppendReg=747;
const OpAppendSplat=748;
const OpAppendSplatConsume=749;
const OpExtractList=750;

opclass(OpPlus) -> 1;
opclass(OpMinus) -> 1;
opclass(OpTimes) -> 1;
opclass(OpShiftLeft) -> 1;
opclass(OpLt) -> 2;
opclass(OpLte) -> 2;
opclass(OpCompLtBr) -> 2;
opclass(OpCompLteBr) -> 2;
opclass(OpShiftRight) -> 2;
opclass(OpDiv) -> 2;
opclass(OpMod) -> 2;
opclass(OpStore) -> 3;
opclass(OpLoad) -> 4;
opclass(OpTrunc) -> 4;
opclass(OpMove) -> 7;
opclass(OpUnaryMinus) -> 3;
opclass(OpBitNot) -> 3;
opclass(OpNot) -> 7;
opclass(OpEqual) -> 5;
opclass(OpNotEqual) -> 5;
opclass(OpCompEqBr) -> 5;
opclass(OpCompNeqBr) -> 5;
opclass(OpAnd) -> 5;
opclass(OpOr) -> 5;
opclass(OpXor) -> 5;
opclass(OpSext) -> 6;
opclass(_) -> 10;

// address encoding for each class - 16 means field not encoded
//                    a  b  z  s sd
opclass_encode(1) ->  4, 3,16, 5,16;
opclass_encode(2) ->  9, 8,10, 5,16;
opclass_encode(3) ->  0,16,16, 8,16;
opclass_encode(4) -> 16,16,16, 8,16;
opclass_encode(5) ->  8, 0,16,16,16;
opclass_encode(6) -> 16,16,16, 8, 0;
opclass_encode(7) ->  0,16,16,16,16;
opclass_encode(10)-> 16,16,16,16,16;
