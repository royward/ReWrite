///////////////////////////////////////////////////////////
// Lexer
///////////////////////////////////////////////////////////

const And=1;
const AndAnd=2;
const Arrow=3;
const Colon=4;
const Comma=6;
const ConstToken=7;
const Divide=8;
const Dot=9;
const Equal=10;
const EqualEqual=11;
const False=12;
const Greater=13;
const GreaterEqual=14;
const GreedySplat=15;
const HashError=16;
const HashNever=17;
const Identifier=18;
const LBrace=19;
const LBracket=20;
const LParen=21;
const Less=22;
const LessEqual=23;
const Minus=24;
const Modulus=25;
const Not=26;
const NotEqual=27;
const Or=28;
const OrOr=29;
const Plus=30;
const RBrace=31;
const RBracket=32;
const RParen=33;
const Semicolon=34;
const ShiftLeft=35;
const ShiftRight=36;
const Star=38;
const True=39;
const Integer=40;
const Wildcard=41;
const Xor=42;
const String=43;
const Char=44;
const Match=45;
const When=46;
const Type=47;
const TypeFn=48;
const Update=49;
const DoubleArrow=50;
const Export=51;

const TargetVM=1;
const TargetX86_64=2;
const TargetAarch64=3;
const TargetVMLL=4;

compile(infile,outfile,targetstring) ->
    match convert_target_string(targetstring) => target
    match parse(target,lex(load_text_file(infile))) => rules,fnnames,symtext,symsz ->
    compile_aux(target,outfile,rules,fnnames,symtext,symsz);

convert_target_string("vm") -> TargetVM;
convert_target_string("vmll") -> TargetVMLL;
convert_target_string("x86-64") -> TargetX86_64;
convert_target_string("aarch64") -> TargetAarch64;

is_start_token(c) -> c=='_' || (c>='a' && c<='z') || (c>='A' && c<='Z');

is_rest_token(c) -> c=='_' || (c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9');

is_digit(c) -> c>='0' && c<='9';

is_whitespace(c) -> c==' ' || c=='\t' || c=='\r';

min(x,y) when x<y -> x;
min(_,y) -> y;

max(x,y) when x>y -> x;
max(_,y) -> y;

lex(s) -> lex_aux({},0,0,s);

lex_aux(acc,row,col,{}) -> acc;
lex_aux(acc,row,col,{c,*rest}) when is_start_token(c) -> match lex_get_token(1,{c},rest) => sz,val,newrest ->
    lex_aux({*acc,{row,col,lex_check_spec_identifier(val),val}},row,col+sz,newrest);
lex_aux(acc,row,col,{c,*rest}) when is_digit(c) -> match lex_get_digit(1,{c},rest) => sz,val,newrest -> lex_aux({*acc,{row,col,Integer,val}},row,col+sz,newrest);
lex_aux(acc,row,col,{c,*rest}) when is_whitespace(c) -> lex_aux(acc,row,col+1,rest);
lex_aux(acc,row,col,{'//',*rest}) -> match lex_aux_absorb_comment(rest) => newrest -> lex_aux(acc,row+1,0,newrest);
lex_aux(acc,row,col,{'\n',*rest}) -> lex_aux(acc,row+1,0,rest);
lex_aux(acc,row,col,{'"',*rest}) -> match lexer_string(row,col+1,{},'"',rest) => newrow,newcol,val,newrest -> lex_aux({*acc,{row,col,String,val}},newrow,newcol,newrest);
lex_aux(acc,row,col,{'\'',*rest}) -> match lexer_string(row,col+1,{},'\'',rest) => newrow,newcol,val,newrest -> lex_aux({*acc,{row,col,Char,val}},newrow,newcol,newrest);
lex_aux(acc,row,col,{'#',*rest}) -> match lex_get_token(1,{},rest) => sz,val,newrest -> lex_aux({*acc,{row,col,lex_do_hash(val),{'#',*val}}},row,col+sz,newrest);
lex_aux(acc,row,col,{c1,c2,*rest}) match lexer_two_symbol(c1,c2) => sym when sym!=0 -> lex_aux({*acc,{row,col,sym,{c1,c2}}},row,col+2,rest);
lex_aux(acc,row,col,{c,*rest}) match lexer_one_symbol(c) => sym when sym!=0 -> lex_aux({*acc,{row,col,sym,{c}}},row,col+1,rest);

lex_get_token(col,sofar,{c,*rest}) when is_rest_token(c) -> lex_get_token(col+1,{*sofar,c},rest);
lex_get_token(*x) -> *x;

lex_check_spec_identifier("true") -> True;
lex_check_spec_identifier("false") -> False;
lex_check_spec_identifier("const") -> ConstToken;
lex_check_spec_identifier("match") -> Match;
lex_check_spec_identifier("update") -> Update;
lex_check_spec_identifier("when") -> When;
lex_check_spec_identifier("type") -> Type;
lex_check_spec_identifier("export") -> Export;
lex_check_spec_identifier("_") -> Wildcard;
lex_check_spec_identifier(x) -> Identifier;

lex_do_hash("error") -> HashError;
lex_do_hash("never") -> HashNever;

lex_get_digit(col,sofar,{c,*rest}) when is_digit(c) -> lex_get_digit(col+1,{*sofar,c},rest);
lex_get_digit(*x) -> *x;

lex_aux_absorb_comment({}) -> {};
lex_aux_absorb_comment({'\n',*rest}) -> rest;
lex_aux_absorb_comment({_,*rest}) -> lex_aux_absorb_comment(rest);

lexer_string(row,col,sofar,endtok,{endtok,*rest}) -> row,col+1,sofar,rest;
lexer_string(row,col,sofar,endtok,{'\\t',*rest}) -> lexer_string(row,col+2,{*sofar,'\t'},endtok,rest);
lexer_string(row,col,sofar,endtok,{'\\r',*rest}) -> lexer_string(row,col+2,{*sofar,'\r'},endtok,rest);
lexer_string(row,col,sofar,endtok,{'\\n',*rest}) -> lexer_string(row,col+2,{*sofar,'\n'},endtok,rest);
lexer_string(row,col,sofar,endtok,{'\\',c,*rest}) -> lexer_string(row,col+2,{*sofar,c},endtok,rest);
lexer_string(row,col,sofar,endtok,{c,*rest}) -> lexer_string(row,col+1,{*sofar,c},endtok,rest);

lexer_two_symbol('&&') -> AndAnd;
lexer_two_symbol('->') -> Arrow;
lexer_two_symbol(':-') -> TypeFn;
lexer_two_symbol('==') -> EqualEqual;
lexer_two_symbol('=>') -> DoubleArrow;
lexer_two_symbol('>=') -> GreaterEqual;
lexer_two_symbol('<=') -> LessEqual;
lexer_two_symbol('!=') -> NotEqual;
lexer_two_symbol('||') -> OrOr;
lexer_two_symbol('<<') -> ShiftLeft;
lexer_two_symbol('>>') -> ShiftRight;
lexer_two_symbol(_,_) -> 0;


lexer_one_symbol(':') -> Colon;
lexer_one_symbol(',') -> Comma;
lexer_one_symbol('/') -> Divide;
lexer_one_symbol('.') -> Dot;
lexer_one_symbol('=') -> Equal;
lexer_one_symbol('>') -> Greater;
lexer_one_symbol('{') -> LBrace;
lexer_one_symbol('[') -> LBracket;
lexer_one_symbol('(') -> LParen;
lexer_one_symbol('<') -> Less;
lexer_one_symbol('-') -> Minus;
lexer_one_symbol('%') -> Modulus;
lexer_one_symbol('!') -> Not;
lexer_one_symbol('|') -> Or;
lexer_one_symbol('&') -> And;
lexer_one_symbol('+') -> Plus;
lexer_one_symbol('}') -> RBrace;
lexer_one_symbol(']') -> RBracket;
lexer_one_symbol(')') -> RParen;
lexer_one_symbol(';') -> Semicolon;
lexer_one_symbol('*') -> Star;
lexer_one_symbol('^') -> Xor;
lexer_one_symbol(_) -> 0;

///////////////////////////////////////////////////////////
// Parser
///////////////////////////////////////////////////////////

// parsing - the program list has three elements:
// - the list of lists of rules
// - the function name associative list
// - the constant associative list

const TypeBool=2;
const TypeChar=3;
const TypeI64=10;

const Const=1;
const ParamId=2;
const ParamWild=3;
const ParamList=4;
const ParamSplat=5;
const ParamSplatWild=6;
const ExprId=2;
const ExprList=4;
const ExprCall=7;
const ExprCallInternal=8;
const ExprCallLibrary=9;
const ExprNever=10;

string_to_int_pos({},acc) -> acc;
string_to_int_pos({c,*rest},acc) -> string_to_int_pos(rest,acc*10+(c-'0'));

int_to_string36(0) -> "0";
int_to_string36(n) when n<10 -> {'0'+n};
int_to_string36(n) when n<36 -> {'a'+n-10};
int_to_string36(n) -> {*int_to_string36(n/36),*int_to_string36(n%36)};

int_to_string(0) -> "0";
int_to_string(n) when n<0 -> {'-',*int_to_string(-n)};
int_to_string(n) when n<10 -> {'0'+n};
int_to_string(n) -> {*int_to_string(n/10),*int_to_string(n%10)};

parse(target,s) -> parse_aux(target,{},{},{},0,{},s);

// get and add for a straight list of (string,ref)
get_add_symbol_list(n,sofar,{},val) -> {*sofar,{val,1}},n;
get_add_symbol_list(n,sofar,{{val,i},*rest},val) -> {*sofar,{val,i+1},*rest},n;
get_add_symbol_list(n,sofar,{x,*rest},val) -> get_add_symbol_list(n+1,{*sofar,x},rest,val);

get_noadd_symbol_list(n,sofar,{{val,i},*rest},val) -> {*sofar,{val,i+1},*rest},n;
get_noadd_symbol_list(n,sofar,{x,*rest},val) -> get_noadd_symbol_list(n+1,{*sofar,x},rest,val);
get_noadd_symbol_list(*_) -> #error;

// get and add for a list of {string,val}
add_symbol_table(done,{},name,val) -> {*done,{name,val}};
add_symbol_table(done,{{name,_},*rest},name,val) -> #error; // already there - should not happen
add_symbol_table(done,{{n,v},*rest},name,val) -> add_symbol_table({*done,{n,v}},rest,name,val);

lookup_symbol_table({},name) -> false,0;
lookup_symbol_table({{name,val},*_},name) -> true,val;
lookup_symbol_table({_,*rest},name) -> lookup_symbol_table(rest,name);

// get/add for a list of {string,val}
// where the value 'false' is special, and can be replaced by another structure
get_add_symbol_table(n,sofar,{},key,val) -> {*sofar,{key,val}},n;
get_add_symbol_table(n,sofar,{{key,false},*rest},key,val) -> {*sofar,{key,val},*rest},n; // keep the non-false value
get_add_symbol_table(n,sofar,{{key,val},*rest},key,false) -> {*sofar,{key,val},*rest},n; // keep the non-false value
get_add_symbol_table(n,sofar,{{key,val},*rest},key,val) -> {*sofar,{key,val},*rest},n;
get_add_symbol_table(n,sofar,{x,*rest},key,val) -> get_add_symbol_table(n+1,{*sofar,x},rest,key,val);

parse_aux(target,rules,fnnames,symtext,symsz,consts,{}) -> rules,fnnames,symtext,symsz;
parse_aux(target,rules,fnnames,symtext,symsz,consts,{{linerule,_,Identifier,name},{_,_,LParen,_},*rest}) ->
    update get_add_symbol_table(0,{},fnnames,name,false) => fnnames,fn_id
    update parse_params(consts,{},{},rest) => bindings,params,{{_,_,RParen,_},*rest}
    update parse_function_match_clauses(consts,{},fnnames,bindings,Arrow,rest) => pre_arrow_clauses,fnnames,bindings,rest
    update parse_match_after_arrow(consts,{},fnnames,bindings,rest) => post_arrow_clauses,fnnames,bindings,rest
    update parse_exprs(consts,fnnames,bindings,{},1,rest) => fnnames,bindings,exprs,{{_,_,Semicolon,_},*rest} ->
    parse_aux(target,add_rule({},rules,fn_id,{linerule+1,bindings,params,pre_arrow_clauses,post_arrow_clauses,exprs}),fnnames,symtext,symsz,consts,rest);
parse_aux(target,rules,fnnames,symtext,symsz,consts,{{fnlineno,_,TypeFn,_},{_,_,Identifier,name},{_,_,LParen,_},*rest}) ->
    update parse_types({},RParen,rest) => types_lhs,rest
    update rest => {{_,_,Arrow,_},*rest}
    update parse_types({},Semicolon,rest) => types_rhs,rest
    update get_add_symbol_table(0,{},fnnames,name,{false,fnlineno+1,symsz,types_lhs,types_rhs}) => fnnames,_ ->
    parse_aux(target,rules,fnnames,add_symtext(target,symtext,symsz,name),consts,rest);
parse_aux(target,rules,fnnames,symtext,symsz,consts,{{fnlineno,_,TypeFn,_},{_,_,Export,_},{_,_,Identifier,name},{_,_,LParen,_},*rest}) ->
    update parse_types({},RParen,rest) => types_lhs,rest
    update rest => {{_,_,Arrow,_},*rest}
    update parse_types({},Semicolon,rest) => types_rhs,rest
    update get_add_symbol_table(0,{},fnnames,name,{true,fnlineno+1,symsz,types_lhs,types_rhs}) => fnnames,_ ->
    parse_aux(target,rules,fnnames,add_symtext(target,symtext,symsz,name),consts,rest);
parse_aux(target,rules,fnnames,symtext,symsz,consts,{{_,_,ConstToken,_},{_,_,Identifier,name},{_,_,Equal,_},{_,_,Integer,val},{_,_,Semicolon,_},*rest}) ->
    parse_aux(target,rules,fnnames,symtext,symsz,add_symbol_table({},consts,name,string_to_int_pos(val,0)),rest);

add_symtext(TargetVM,symtext,symsz,name) -> {*symtext,*name,'\0'},symsz+length(name)+1;
add_symtext(TargetVMLL,symtext,symsz,name) -> {*symtext,*name,'\0'},symsz+length(name)+1;
add_symtext(_,symtext,symsz,name) -> {*symtext,*name,'\\00'},symsz+length(name)+1;

parse_types(sofar,endtok,{{_,_,endtok,_},*rest}) -> sofar,rest;
parse_types(sofar,endtok,{{_,_,Identifier,_},{_,_,Colon,_},*rest}) -> parse_types(sofar,endtok,rest);
parse_types(sofar,endtok,{{_,_,Identifier,tp},*rest}) match base_type(tp) => true,convert -> parse_types1({*sofar,convert},endtok,rest);
parse_types(sofar,endtok,{{_,_,LBrace,_},*rest}) -> match parse_types({},RBrace,rest) => inside,rest -> parse_types1({*sofar,{true,inside}},endtok,rest);

parse_types1(sofar,endtok,{{_,_,Comma,_},*rest}) -> parse_types(sofar,endtok,rest);
parse_types1(sofar,endtok,{{_,_,endtok,_},*rest}) -> sofar,rest; // deal with no trailing comma

base_type("i64") -> true,TypeI64;
base_type("bool") -> true,TypeBool;
base_type("char") -> true,TypeChar;
base_type("string") -> true,{true,Char};
base_type(_) -> HashNever;

add_rule(sofar,{},n,x) -> add_rule(sofar,{{}},n,x);
add_rule(sofar,{r,*rest},0,x) -> {*sofar,{*r,x},*rest};
add_rule(sofar,{r,*rest},n,x) -> add_rule({*sofar,r},rest,n-1,x);

parse_function_match_clauses(consts,sofar,fnnames,bindings,endtok,{{_,_,endtok,_},*rest}) -> sofar,fnnames,bindings,rest;
parse_function_match_clauses(consts,sofar,fnnames,bindings,endtok,{{_,_,When,_},*rest}) ->
    update parse_exprs(consts,fnnames,bindings,{},1,rest) => fnnames2,bindings,expr,rest2 ->
    parse_function_match_clauses(consts,{*sofar,{{{Const,{TypeBool,1}}},expr}},fnnames2,bindings,endtok,rest2);
parse_function_match_clauses(consts,sofar,fnnames,bindings,endtok,{{_,_,tok,_},*rest}) match match_or_update(tok) => true,upd ->
    update parse_exprs(consts,fnnames,bindings,{},1,rest) => fnnames,bindings,expr,{{_,_,DoubleArrow,_},*rest}
    update parse_params(consts,bindings,{},rest) => bindings,params,rest ->
    parse_function_match_clauses(consts,{*sofar,{upd,params,expr}},fnnames,bindings,endtok,rest);

match_or_update(Match) -> true,false;
match_or_update(Update) -> true,true;
match_or_update(_) -> false,false;

parse_match_after_arrow(_,_,fnnames,bindings,{{r,c,tok,val},*rest}) when tok!=When && tok!=Match && tok!=Update -> {},fnnames,bindings,{{r,c,tok,val},*rest}; // no clauses after arrow
parse_match_after_arrow(consts,sofar,fnnames,bindings,rest) -> parse_function_match_clauses(consts,{},fnnames,bindings,Arrow,rest);

parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,Minus,_},{_,_,Integer,val},*rest}) -> parse_exprs1(consts,fnnames,bindings,sofar,{Const,{TypeI64,-string_to_int_pos(val,0)}},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,Integer,val},*rest}) -> parse_exprs1(consts,fnnames,bindings,sofar,{Const,{TypeI64,string_to_int_pos(val,0)}},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,False,_},*rest}) -> parse_exprs1(consts,fnnames,bindings,sofar,{Const,{TypeBool,0}},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,True,_},*rest}) -> parse_exprs1(consts,fnnames,bindings,sofar,{Const,{TypeBool,1}},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,HashError,_},*rest}) -> parse_exprs1(consts,fnnames,bindings,sofar,{ExprNever,{}},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,HashNever,_},*rest}) -> parse_exprs1(consts,fnnames,bindings,sofar,{ExprNever,{}},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,Identifier,id},{_,_,LParen,_},*rest}) ->
    update get_add_symbol_table(0,{},fnnames,id,false) => fnnames,fn_id
    update parse_exprs(consts,fnnames,bindings,{},1,rest) => fnnames,bindings,args,{{_,_,RParen,_},*rest} ->
    parse_exprs1(consts,fnnames,bindings,sofar,{ExprCall,fn_id,args},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,LBrace,_},*rest}) ->
    update parse_exprs(consts,fnnames,bindings,{},1,rest) => fnnames,bindings,args,{{_,_,RBrace,_},*rest}  ->
    parse_exprs1(consts,fnnames,bindings,sofar,{ExprList,args},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,LParen,_},*rest}) ->
    update parse_exprs(consts,fnnames,bindings,{},1,rest) => fnnames,bindings,{expr},{{_,_,RParen,_},*rest} ->
    parse_exprs1(consts,fnnames,bindings,sofar,expr,pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,Char,{c}},*rest}) -> parse_exprs1(consts,fnnames,bindings,sofar,{Const,{TypeChar,char_to_int(c)}},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,Char,str},*rest}) -> parse_exprs1nothis(consts,fnnames,bindings,{*sofar,*string_to_expr_param_list({},str)},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,String,str},*rest}) -> parse_exprs1(consts,fnnames,bindings,sofar,{ExprList,string_to_expr_param_list({},str)},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,Identifier,id},*rest}) match lookup_symbol_table(consts,id) => ok,val when ok ->
    parse_exprs1(consts,fnnames,bindings,sofar,{Const,{TypeI64,val}},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,Identifier,id},*rest}) ->
    update get_noadd_symbol_list(0,{},bindings,id) => bindings,bindnum ->
    parse_exprs1(consts,fnnames,bindings,sofar,{ExprId,{bindnum}},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,pri,{{_,_,tok,_},*rest}) match prefix_binding_power(tok) => pre_pri when pre_pri>0 ->
    update parse_exprs(consts,fnnames,bindings,{},pre_pri,rest) => fnnames,bindings,{arg},rest ->
    parse_exprs1(consts,fnnames,bindings,sofar,{tok,arg},pri,rest);
parse_exprs(consts,fnnames,bindings,sofar,_,rest) -> fnnames,bindings,sofar,rest;

parse_exprs1(consts,fnnames,bindings,sofar,this,1,{{_,_,Comma,_},*rest}) -> parse_exprs(consts,fnnames,bindings,{*sofar,this},1,rest);
parse_exprs1(consts,fnnames,bindings,sofar,this,pri,{{r,c,tok,val},*rest}) match infix_binding_power(tok) => p1,p2 when p1>=pri ->
    update parse_exprs(consts,fnnames,bindings,{},p2,rest) => fnnames,bindings,second,rest ->
    parse_exprs1(consts,fnnames,bindings,sofar,{ExprCallInternal,{tok,this,*second}},pri,rest);
parse_exprs1(consts,fnnames,bindings,sofar,this,_,rest) -> fnnames,bindings,{*sofar,this},rest;

parse_exprs1nothis(consts,fnnames,bindings,sofar,1,{{_,_,Comma,_},*rest}) -> parse_exprs(consts,fnnames,bindings,sofar,1,rest);
parse_exprs1nothis(consts,fnnames,bindings,sofar,_,rest) -> fnnames,bindings,sofar,rest;

string_to_expr_param_list(sofar,{}) -> sofar;
string_to_expr_param_list(sofar,{c,*rest}) -> string_to_expr_param_list({*sofar,{Const,{TypeChar,char_to_int(c)}}},rest);

prefix_binding_power(Minus) -> 110;
prefix_binding_power(Not) -> 110;
prefix_binding_power(Star) -> 180;
prefix_binding_power(_) -> 0;

infix_binding_power(OrOr) -> 10,11;
infix_binding_power(AndAnd) -> 30,31;
infix_binding_power(EqualEqual) -> 50,51;
infix_binding_power(NotEqual) -> 50,51;
infix_binding_power(Less) -> 50,51;
infix_binding_power(Greater) -> 50,51;
infix_binding_power(LessEqual) -> 50,51;
infix_binding_power(GreaterEqual) -> 50,51;
infix_binding_power(Or) -> 70,71;
infix_binding_power(Xor) -> 90,91;
infix_binding_power(And) -> 110,111;
infix_binding_power(ShiftLeft) -> 130,131;
infix_binding_power(ShiftRight) -> 130,131;
infix_binding_power(Plus) -> 150,151;
infix_binding_power(Minus) -> 150,151;
infix_binding_power(Star) -> 170,171;
infix_binding_power(Divide) -> 170,171;
infix_binding_power(Modulus) -> 170,171;
infix_binding_power(_) -> 0,0;

parse_params(consts,bindings,params,{{_,_,False,_},*rest}) -> parse_params1(consts,bindings,{*params,{Const,{TypeBool,0}}},rest);
parse_params(consts,bindings,params,{{_,_,True,_},*rest}) -> parse_params1(consts,bindings,{*params,{Const,{TypeBool,1}}},rest);
parse_params(consts,bindings,params,{{_,_,Integer,val},*rest}) -> parse_params1(consts,bindings,{*params,{Const,{TypeI64,string_to_int_pos(val,0)}}},rest);
parse_params(consts,bindings,params,{{_,_,Minus,_},{_,_,Integer,val},*rest}) -> parse_params1(consts,bindings,{*params,{Const,{TypeI64,-string_to_int_pos(val,0)}}},rest);
parse_params(consts,bindings,params,{{_,_,Wildcard,_},*rest}) -> parse_params1(consts,bindings,{*params,{ParamWild,{}}},rest);
parse_params(consts,bindings,params,{{_,_,Star,_},{_,_,Wildcard,_},*rest}) -> parse_params1(consts,bindings,{*params,{ParamSplatWild,{}}},rest);
parse_params(consts,bindings,params,{{_,_,Identifier,name},*rest}) match lookup_symbol_table(consts,name) => ok,val when ok -> parse_params1(consts,bindings,{*params,{Const,{TypeI64,val}}},rest);
parse_params(consts,bindings,params,{{_,_,Identifier,name},*rest}) -> match get_add_symbol_list(0,{},bindings,name) => newbindings,id -> parse_params1(consts,newbindings,{*params,{ParamId,{id}}},rest);
parse_params(consts,bindings,params,{{_,_,Star,_},{_,_,Identifier,name},*rest}) ->
    match get_add_symbol_list(0,{},bindings,name) => newbindings,id -> parse_params1(consts,newbindings,{*params,{ParamSplat,{id}}},rest);
parse_params(consts,bindings,params,{{_,_,LBrace,_},*rest}) ->
    update parse_params(consts,bindings,{},rest) => bindings,list_params,{{_,_,RBrace,_},*rest} ->
    parse_params1(consts,bindings,{*params,{ParamList,list_params}},rest);
parse_params(consts,bindings,params,{{_,_,Char,str},*rest}) -> parse_params1(consts,bindings,{*params,*string_to_expr_param_list({},str)},rest);
parse_params(consts,bindings,params,{{_,_,String,str},*rest}) -> parse_params1(consts,bindings,{*params,{ParamList,string_to_expr_param_list({},str)}},rest);
parse_params(consts,bindings,params,rest) -> bindings,params,rest;

parse_params1(consts,bindings,params,{{_,_,Comma,_},*rest}) -> parse_params(consts,bindings,params,rest);
parse_params1(consts,bindings,params,rest) -> bindings,params,rest; // deal with no trailing comma

///////////////////////////////////////////////////////////
// Compiler
///////////////////////////////////////////////////////////

nth(0,{a,*_}) -> a;
nth(n,{_,*rest}) -> nth(n-1,rest);

split3_nth(0,sofar,{a,*rest}) -> sofar,a,rest;
split3_nth(n,sofar,{a,*rest}) -> split3_nth(n-1,{*sofar,a},rest);

get_aligned_bitmask(n,sofar,{},sz) -> get_aligned_bitmask(n,sofar,{0},sz);
get_aligned_bitmask(n,sofar,{-1,*rest},sz) -> get_aligned_bitmask(n+64,{*sofar,-1},rest,sz); // short circuit if fully allocated
get_aligned_bitmask(n,sofar,{b,*rest},sz) -> match find_bitmask(0,b,sz,(1<<sz)-1) => true,offset,new -> {*sofar,new,*rest},n+offset;
get_aligned_bitmask(n,sofar,{b,*rest},sz) -> get_aligned_bitmask(n+64,{*sofar,b},rest,sz);

find_bitmask(64,_,_,_) -> false,0,0;
find_bitmask(offset,bitmask,sz,mask) when bitmask&mask==0 -> true,offset,bitmask|mask;
find_bitmask(offset,bitmask,sz,mask) -> find_bitmask(offset+sz,bitmask,sz,mask<<sz);

bitmask_size({}) -> 0;
bitmask_size({a}) -> 64-count_leading_zeros(a);
bitmask_size({_,*rest}) -> 64+bitmask_size(rest);

bitmask_or(sofar,{},rest2) -> {*sofar,*rest2};
bitmask_or(sofar,rest1,{}) -> {*sofar,*rest1};
bitmask_or(sofar,{b1,*rest1},{b2,*rest2}) -> bitmask_or({*sofar,b1|b2},rest1,rest2);

length({}) -> 0;
length({_,*rest}) -> length(rest)+1;

compile_aux(target,outfile,rules,table,symtext,symsz) ->
    match annotate_table({},table) => annotated_table ->
    compile1(target,outfile,length(table)-1,0,annotated_table,symtext,symsz,{},rules);

const MaxParamRegs=4;

annotate_table(sofar,{}) -> sofar;
annotate_table(sofar,{{name,{exportx,fnlineno,symoffset,types_left,types_right}},*rest}) ->
    annotate_table({*sofar,{exportx,fnlineno,symoffset,name,annotate_type_list_reg(0,0,{},{},create_start_annotated_list({},types_left)),
                                  annotate_type_list_reg(0,0,{},{},create_start_annotated_list({},types_right))}},rest);

create_start_annotated_list(sofar,{}) -> sofar;
create_start_annotated_list(sofar,{{true,x},*rest}) -> create_start_annotated_list({*sofar,{{{},{}},{true,x}}},rest);
create_start_annotated_list(sofar,{{false,x},*rest}) -> create_start_annotated_list({*sofar,{{{},{}},{false,x}}},rest);
create_start_annotated_list(sofar,{n,*rest}) -> create_start_annotated_list({*sofar,{{{}},n}},rest);

const BindImm=0;
const BindLabel=0;
const BindReg=1;
const BindOverflow=2;
const BindArgRet=3;
const BindInOut=4;

annotate_type_list_reg(pri,max_reg,reg_count,sofar,{}) -> annotate_type_list_reg(pri+1,max_reg,reg_count,{},sofar);
annotate_type_list_reg(pri,max_reg,reg_count,sofar,todo) when pri==3 || max_reg==MaxParamRegs -> reg_count,annotate_type_list_stack({},{},{*sofar,*todo});
annotate_type_list_reg(pri,max_reg,reg_count,sofar,{{{{}},t},*rest}) match get_type_size_pri(t) => {p,sz} when p<=pri ->
    annotate_type_list_reg(pri,max_reg+1,{*reg_count,sz},{*sofar,{{{BindArgRet,max_reg}},t}},rest);
annotate_type_list_reg(pri,max_reg,reg_count,sofar,{{{{},r},t},*rest}) match get_type_size_pri(t) => {p,sz,_,_} when p<=pri ->
    annotate_type_list_reg(pri,max_reg+1,{*reg_count,sz},{*sofar,{{{BindArgRet,max_reg},r},t}},rest);
annotate_type_list_reg(pri,max_reg,reg_count,sofar,{{{r,{}},t},*rest}) match get_type_size_pri(t) => {_,_,p,sz} when p<=pri ->
    annotate_type_list_reg(pri,max_reg+1,{*reg_count,sz},{*sofar,{{r,{BindArgRet,max_reg}},t}},rest);
annotate_type_list_reg(pri,max_reg,reg_count,sofar,{t,*rest}) -> annotate_type_list_reg(pri,max_reg,reg_count,{*sofar,t},rest);

annotate_type_list_stack(stack,sofar,{}) -> stack,sofar;
annotate_type_list_stack(stack,sofar,{{{{}},t},*rest}) match get_type_size_pri(t) => {p,sz} update get_aligned_bitmask(0,{},stack,sz) => stack,offset ->
    annotate_type_list_stack(stack,{*sofar,{{{BindOverflow,offset}},t}},rest);
annotate_type_list_stack(stack,sofar,{{{{},r},t},*rest}) match get_type_size_pri(t) => {p,sz,_,_} update get_aligned_bitmask(0,{},stack,sz) => stack,offset ->
    annotate_type_list_stack(stack,{*sofar,{{{BindOverflow,offset},r},t}},rest);
annotate_type_list_stack(stack,sofar,{{{r,{}},t},*rest}) match get_type_size_pri(t) => {_,_,p,sz} update get_aligned_bitmask(0,{},stack,sz) => stack,offset ->
    annotate_type_list_stack(stack,{*sofar,{{r,{BindOverflow,offset}},t}},rest);
annotate_type_list_stack(stack,sofar,{t,*rest}) -> annotate_type_list_stack(stack,{*sofar,t},rest);

get_type_size_pri(TypeBool) -> {0,8}; // just make everything size 8 for the first pass
get_type_size_pri(TypeChar) -> {0,8};
get_type_size_pri(TypeI64) -> {0,8};
get_type_size_pri({true,_}) -> {1,4,2,4};
get_type_size_pri({false,_}) -> {1,4,2,4};

const OpLabel=1;
const OpError=2;
const OpRet=3;
const OpAddStack=5;
const OpMove=16;
const OpInsert=32;
const OpExtract=48;
const OpCompareNotEqualBranch=240;
const OpCompareEqualBranch=248;
const OpGoto=254;
const OpCall=255;

// Error in VM=1
const ErrNoMemory=2;
const ErrNoMatch=3;
const ErrUser=4;

compile1(TargetVM,outfile,label_id,_,table,symtext,_,sofar,{}) -> compile1_vm(TargetVM,outfile,label_id,table,symtext,sofar);
compile1(TargetVMLL,outfile,label_id,_,table,symtext,_,sofar,{}) -> compile1_vm(TargetVMLL,outfile,label_id,table,symtext,sofar);
compile1(target,outfile,label_id,_,table,symtext,symsz,sofar,{}) ->
    match create_export_wrappers_ll(target,{},{},label_id,table) => wrapper_code,wrapperh ->
    save_text_file({*outfile,'.ll'},{*convert_to_llvm(target,minify_table({},table),table,symtext,symsz,{},sofar),*wrapper_code,*ll_boilerplate_end()}),
    save_c_header(target,outfile,wrapperh);
compile1(target,outfile,label_id,n,table,symtext,symsz,sofar,{rules,*rest}) ->
    match nth(n,table) => {_,_,_,_,reg_count1,bitmask1,type_left,reg_count2,bitmask2,type_right}
    update compile_function(target,0,true,0,label_id,n,table,0,{{n,0,OpLabel,0,BindLabel,n}},rules,0,bitmask_or({},bitmask1,bitmask2),type_left,type_right) => label_id,code ->
    compile1(target,outfile,label_id,n+1,table,symtext,symsz,{*sofar,{n,code}},rest);

compile1_vm(target,outfile,label_id,table,symtext,sofar) ->
    match create_export_wrappers_vm(target,{},{},0,label_id,table) => wrapper_code,wrapperh
    match {*sofar,*wrapper_code} => vmcode ->
    save_c_header(target,outfile,wrapperh),
    save_binary_file({*outfile,'.rwo'},{*convert_to_binary({*emitb(28,{},0),*emitb(4,{},code_length(0,vmcode)+1)},vmcode),*text_to_byte({},symtext)});

text_to_byte(sofar,{}) -> sofar;
text_to_byte(sofar,{c,*rest}) -> text_to_byte({*sofar,c-'\0'},rest);

code_length(n,{}) -> n;
code_length(n,{{_,a},*rest}) -> code_length(n+length(a),rest);

compile_function(target,reg_count,active,lblnext,label_id,fn_id,table,rule_id,sofar,{},_,_,_,_) ->
    match nth(fn_id,table) => {_,fnlineno,symoffset,_,reg_count1,bitmask1,type_left,reg_count2,bitmask2,type_right} ->
    label_id,{*sofar,*code_or_not(active,{{fn_id,rule_id,OpError,ErrNoMatch,0,fnlineno,0,symoffset}})};
compile_function(target,reg_count,active,lblnext,label_id,fn_id,table,rule_id,sofar,{rule,*rest},dummy,bitmask,type_left,type_right) ->
    match rule => {linerule,bindings,params,pre_arrow_clauses,post_arrow_clauses,exprs}
    update compile_rule(linerule,lblnext,{target,1,0,true,0,label_id,fn_id,rule_id,create_compiler_bindings({},bindings),reg_count,bitmask,{},table},{},params,pre_arrow_clauses,post_arrow_clauses,exprs,type_left,type_right) =>
        reg_count,active,lblnext,label_id,code ->
    compile_function(target,reg_count,active,0,label_id,fn_id,table,rule_id+1,{*sofar,*code,*code_or_not(active,{{fn_id,rule_id,OpLabel,0,BindLabel,label_id}})},rest,dummy,bitmask,type_left,type_right);

create_compiler_bindings(sofar,{}) -> sofar;
create_compiler_bindings(sofar,{{n,ref},*rest}) -> create_compiler_bindings({*sofar,{0,0,{},n,ref}},rest);

//ctx_fn({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table}) -> fn_id;
ctx_fnr({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table}) -> fn_id,rule_id;
ctx_lbl({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table}) -> label_id;
ctx_bindings({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table}) -> bindings;
//ctx_deref_param({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table},n) ->
//    update clear1_reglist({target,},reg_count,n) => reg_count ->
//    {target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table};
ctx_newbindings({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table},newbindings) -> {target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,newbindings,reg_count,bitmask,bind_rhs,table};
ctx_get_reg_count({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table}) -> reg_count;
ctx_put_reg_count({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,_,bitmask,bind_rhs,table},new_reg_count) -> {target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,new_reg_count,bitmask,bind_rhs,table};
ctx_get_bitmask({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table}) -> bitmask;
ctx_newreg({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table},sz) ->
    {target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count+1,bitmask,bind_rhs,table},reg_count;
ctx_get_bind_rhs({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table}) -> bind_rhs;
ctx_get_fn_sig({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table},n) -> nth(n,table);
ctx_set_tail({target,callctr,_,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table},tailcall) -> {target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table};
ctx_get_tail({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table}) -> tailcall;
ctx_set_lblnext({target,callctr,tailcall,active,_,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table}) -> {target,callctr,tailcall,active,label_id,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table};
ctx_get_lblnext({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table}) -> lblnext;
ctx_get_lbl_stuff({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table}) -> target,active,lblnext,label_id;
ctx_get_lbl_active({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table}) -> active;
ctx_set_lbl_stuff({target,callctr,tailcall,active,_,_,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table},lblnext,label_id) ->
    {target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table};
ctx_update_get_callctr({TargetVM,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table},inc) ->
    {TargetVM,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table},0;
ctx_update_get_callctr({target,callctr,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table},inc) ->
    {target,callctr+inc,tailcall,active,lblnext,label_id,fn_id,rule_id,bindings,reg_count,bitmask,bind_rhs,table},callctr;

// deal with tail recursion (error if sigs don't match)
compile_rule(linerule,lblnext,ctx,sofar,params,pre_arrow_clauses,post_arrow_clauses,{{ExprCall,fn_id,args}},type_left,type_right)
    match ctx_get_tail(ctx) => 0
    match ctx_get_fn_sig(ctx,fn_id) => {_,_,_,_,_,_,type_left_new,_,_,type_right} ->
    compile_rule(linerule,lblnext,ctx_set_tail(ctx,fn_id+1),sofar,params,pre_arrow_clauses,post_arrow_clauses,args,type_left,type_left_new);
compile_rule(linerule,lblnext,ctx,sofar,params,pre_arrow_clauses,post_arrow_clauses,exprs,type_left,type_right)
    match ctx_get_tail(ctx) => 0 ->
    update generate_param_code(ctx,{},{},type_left,params) => ctx,code
    update generate_expr_code(0,ctx,code,{},type_right,exprs) => ctx,code ->
    ctx_get_reg_count(ctx),ctx_get_lbl_active(ctx)&&ctx_get_lblnext(ctx)!=0,if_not_zero(lblnext,ctx_get_lblnext(ctx),0),ctx_lbl(ctx),code_or_not(ctx_get_lbl_active(ctx),{*code,{ctx_fnr(ctx),OpRet,0}});
//compile_rule(linerule,lblnext,ctx,sofar,params,pre_arrow_clauses,post_arrow_clauses,exprs,type_left,type_right)

// compile_rule(linerule,lblnext,ctx,sofar,params,pre_arrow_clauses,post_arrow_clauses,exprs,type_left,type_right) ->
//     update generate_param_code(ctx,{},{},type_left,params) => ctx,code
//     update generate_expr_code(0,ctx,code,{},type_right,exprs) => ctx,code ->
//     ctx_get_reg_count(ctx),ctx_get_lbl_active(ctx)&&ctx_get_lblnext(ctx)!=0,if_not_zero(lblnext,ctx_get_lblnext(ctx),0),ctx_lbl(ctx),code_or_not(ctx_get_lbl_active(ctx),{*code,compile_end(ctx_get_tail(ctx),ctx)});

//generate_expr_code_aux(ctx,{ExprCall,fn_id,args}) match ctx_get_fn_sig(ctx,fn_id) => {_,fnlineno,_,_,regleft,maskleft,params_left,regright,maskright,{{{{ret_flags,ret}},tp}}} ->
//    update ctx_update_get_callctr(ctx,max(length(params_left),1)) => ctx,callctr
//    update generate_expr_code(callctr,ctx,{},{},params_left,args) => ctx,args_code
//    match ctx_get_reg_count(ctx)+1 => spinc
//    match get_scalar_type_size(tp) => sz
//    update ctx_newreg(ctx,1<<sz) => ctx,newreg ->
//    ctx,{*args_code,
//        {ctx_fnr(ctx),OpCall,0,BindLabel,fn_id,0,spinc,0,callctr},
//        {ctx_fnr(ctx),OpAddStack,0,0,0,0,-spinc},
//        {ctx_fnr(ctx),if_not_zero(callctr,OpExtract,OpMove)+sz,0,BindReg,newreg,ret_flags,ret,0,callctr},
//        },
//    false,tp,BindReg,newreg;


if_not_zero(0,_,y) -> y;
if_not_zero(_,x,_) -> x;

compile_end(0,ctx) -> {ctx_fnr(ctx),OpRet,0};
compile_end(n,ctx) -> {ctx_fnr(ctx),OpGoto,0,BindLabel,n-1};

compile_rhs_final_binding(_,sofar,{}) -> sofar;
compile_rhs_final_binding(ctx,sofar,{{tp,src,dst},*rest}) -> compile_rhs_final_binding(ctx,{*sofar,{ctx_fnr(ctx),OpMove+get_scalar_type_size(tp),0,BindReg,dst,BindReg,src}},rest);

code_or_not(false,_) -> {};
code_or_not(_,code) -> code;

get_scalar_type_size(tp) match get_type_size_pri(tp) => {_,sz} -> 63-count_leading_zeros(sz);

generate_param_code(ctx,sofar0,sofar1,{},{}) -> ctx,{*sofar0,*sofar1};
generate_param_code(ctx,sofar0,sofar1,{{{{BindArgRet,src}},tp},*type_left},{{Const,{tp,val}},*rest}) ->
    update generate_conditional(ctx,OpCompareNotEqualBranch,tp,BindArgRet,src,BindImm,val) => ctx,code ->
    generate_param_code(ctx,{*sofar0,*code},sofar1,type_left,rest);
generate_param_code(ctx,sofar0,sofar1,{{{{BindArgRet,src}},tp},*type_left},{{ParamId,{id}},*rest}) ->
    update ctx_bindings(ctx) => bindings
    update split3_nth(id,{},bindings) => prebind,bind,postbind
    update generate_bind_variable(ctx,BindArgRet,src,tp,bind) => ctx,newbind,code
    update ctx_newbindings(ctx,{*prebind,newbind,*postbind}) => ctx ->
    generate_param_code(ctx,sofar0,{*sofar1,*code},type_left,rest);
generate_param_code(ctx,sofar0,sofar1,{{{{BindArgRet,src}},tp},*type_left},{{ParamWild,{}},*rest}) ->
    generate_param_code(ctx,sofar0,sofar1,type_left,rest);

generate_bind_variable(ctx,src_flag,src,tp,{0,_,_,name,refs}) ->
    update ctx_newreg(ctx,1<<get_scalar_type_size(tp)) => ctx,newreg ->
    ctx,{refs+1,tp,{BindReg,newreg},name},{generate_to_reg_move(ctx_fnr(ctx),tp,newreg,src_flag,src)};
generate_bind_variable(ctx,src_flag,src,tp,{refs,tp,{src_flag2,src2},name}) ->
    update generate_conditional(ctx,OpCompareNotEqualBranch,tp,src_flag,src,src_flag2,src2) => ctx,code ->
    ctx,{refs-1,tp,{src_flag2,src2},name},code;

generate_to_reg_move(fn_id,rule_id,tp,newreg,src_flag,src) -> {fn_id,rule_id,OpMove+get_scalar_type_size(tp),0,BindReg,newreg,src_flag,src};

generate_conditional(ctx,op,tp,src_flag,src,src_flag2,src2) -> generate_conditional_aux(ctx,ctx_get_lbl_stuff(ctx),op,tp,src_flag,src,src_flag2,src2);

generate_conditional_aux(ctx,target,0,lblnext,label_id,op,tp,src_flag,src,src_flag2,src2) -> ctx,{};
generate_conditional_aux(ctx,TargetVM,_,0,label_id,op,tp,src_flag,src,src_flag2,src2) ->
    ctx_set_lbl_stuff(ctx,label_id+1,label_id+1),{{ctx_fnr(ctx),op+get_scalar_type_size(tp),0,BindLabel,label_id+1,src_flag,src,src_flag2,src2}};
generate_conditional_aux(ctx,TargetVM,_,lblnext,label_id,op,tp,src_flag,src,src_flag2,src2) -> ctx,{{ctx_fnr(ctx),op,tp,BindLabel,lblnext,src_flag,src,src_flag2,src2}};
generate_conditional_aux(ctx,_,_,0,label_id,op,tp,src_flag,src,src_flag2,src2) ->
    update generate_conditional_extractx(ctx,tp,src_flag,src) => ctx,newbind,newreg,code ->
    ctx_set_lbl_stuff(ctx,label_id+2,label_id+2),{*code,{ctx_fnr(ctx),op+get_scalar_type_size(tp),0,BindLabel,label_id+2,newbind,newreg,src_flag2,src2,label_id+1},{ctx_fnr(ctx),OpLabel,0,BindLabel,label_id+1}};
generate_conditional_aux(ctx,_,_,lblnext,label_id,op,tp,src_flag,src,src_flag2,src2) ->
    update generate_conditional_extractx(ctx,tp,src_flag,src) => ctx,newbind,newreg,code ->
    ctx_set_lbl_stuff(ctx,label_id+1,label_id+1),{*code,{ctx_fnr(ctx),op+get_scalar_type_size(tp),0,BindLabel,lblnext,newbind,newreg,src_flag2,src2,lblnext},{ctx_fnr(ctx),OpLabel,0,BindLabel,label_id+1}};

generate_conditional_extractx(ctx,tp,BindArgRet,src) ->
    update ctx_newreg(ctx,1<<get_scalar_type_size(tp)) => ctx,newreg ->
    ctx,BindReg,newreg,{generate_to_reg_move(ctx_fnr(ctx),tp,newreg,BindArgRet,src)};
generate_conditional_extractx(ctx,tp,src_flag,src) -> ctx,src_flag,src,{};

use_binding(ctx,id) ->
    match split3_nth(id,{},ctx_bindings(ctx)) => prebind,{refs,tp,{src_flag,src},name},post_bind
    update use_binding_check_reg_end(ctx,refs,src) => ctx ->
    ctx_newbindings(ctx,{*prebind,{refs-1,tp,{src_flag,src},name},*post_bind}),tp,src_flag,src;

use_binding_check_reg_end(ctx,2,src) -> match split3_nth(src,{},ctx_get_reg_count(ctx)) => prebind,_,post_bind -> ctx_put_reg_count(ctx,{*prebind,0,*post_bind});
use_binding_check_reg_end(ctx,ref,_) -> ctx;

generate_expr_code(_,ctx,code1,code2,{},{}) -> ctx,{*code1,*code2};
// TODO deal with lists splats and multi-return calls first
generate_expr_code(callctr,ctx,sofar1,sofar2,{{{{dst_flag,dst}},tp},*type_left},{expr,*rest}) ->// when dst<=ctx_get_maxreg_rhs(ctx) ->
    update generate_expr_code_aux(ctx,expr) => ctx,newcode,{{bound_param,tp,src_flag,src}} ->
    generate_expr_code(callctr,ctx,{*sofar1,*newcode},{*sofar2,{ctx_fnr(ctx),if_not_zero(callctr,OpInsert,OpMove)+get_scalar_type_size(tp),0,dst_flag,dst,src_flag,src,0,callctr}},type_left,rest);
// generate_expr_code(redirect,ctx,sofar,{{{{dst_flag,dst}},tp},*type_left},{expr,*rest}) ->
//     match generate_expr_code_aux(ctx,expr) => newcode,tp,src_flag,src ->
//     generate_expr_code(redirect,ctx,{*sofar,*newcode,{ctx_fnr(ctx),OpMove+get_scalar_type_size(tp),0,dst_flag,dst,src_flag,src}},type_left,rest);


generate_expr_code_aux(ctx,{Const,{tp,val}}) -> ctx,{},{{true,tp,BindImm,val}};
generate_expr_code_aux(ctx,{ExprId,{id}}) -> update use_binding(ctx,id) => ctx,tp,src_flag,src -> ctx,{},{{true,tp,src_flag,src}};
generate_expr_code_aux(ctx,{ExprCallInternal,{op,*args}}) -> update generate_expr_code_aux_map(ctx,{},args) => ctx,args_code -> generate_expr_code_infix(ctx,op,args_code);
generate_expr_code_aux(ctx,{ExprCall,fn_id,args}) match ctx_get_fn_sig(ctx,fn_id) => {_,fnlineno,_,_,regleft,maskleft,params_left,regright,maskright,{{{{ret_flags,ret}},tp}}} ->
    update ctx_update_get_callctr(ctx,max(length(params_left),1)) => ctx,callctr
    update generate_expr_code(callctr,ctx,{},{},params_left,args) => ctx,args_code
    match ctx_get_reg_count(ctx)+1 => spinc
    match get_scalar_type_size(tp) => sz
    update ctx_newreg(ctx,1<<sz) => ctx,newreg ->
    ctx,{*args_code,
        {ctx_fnr(ctx),OpCall,0,BindLabel,fn_id,0,spinc,0,callctr},
        {ctx_fnr(ctx),OpAddStack,0,0,0,0,-spinc},
        {ctx_fnr(ctx),if_not_zero(callctr,OpExtract,OpMove)+sz,0,BindReg,newreg,ret_flags,ret,0,callctr},
        },
    {{false,tp,BindReg,newreg}};

const OpPlus=24;
const OpMinus=25;
const OpTimes=26;
const OpDiv=27;
const OpMod=28;

binop(Plus) -> true,OpPlus;
binop(Minus) -> true,OpMinus;
binop(Star) -> true,OpTimes;
binop(Divide) -> true,OpDiv;
binop(Modulus) -> true,OpMod;
binop(_) -> false,0;


generate_expr_code_infix(ctx,op,{{code1,{{bp1,tp,src_flag1,src1}}},{code2,{{bp2,tp,src_flag2,src2}}}}) match binop(op) => true,machine_op ->
    match get_scalar_type_size(tp) => sz
    update ctx_newreg(ctx,1<<sz) => ctx,newreg ->
    ctx,{*code1,*code2,{ctx_fnr(ctx),machine_op,tp,BindReg,newreg,src_flag1,src1,src_flag2,src2}},{{false,tp,BindReg,newreg}};

generate_expr_code_aux_map(ctx,sofar,{}) -> ctx,sofar;
generate_expr_code_aux_map(ctx,sofar,{expr,*rest}) -> update generate_expr_code_aux(ctx,expr) => ctx,code,results -> generate_expr_code_aux_map(ctx,{*sofar,{code,results}},rest);

///////////////////////////////////////////////////////////
// VM
///////////////////////////////////////////////////////////

convert_to_binary(sofar,{}) -> sofar;
convert_to_binary(sofar,{{fnid,code},*rest}) -> convert_to_binary({*sofar,*convert_to_binary_aux({},code)},rest);

convert_to_binary_aux(sofar,{}) -> sofar;
convert_to_binary_aux(sofar,{instr,*rest}) -> convert_to_binary_aux({*sofar,*emit_instruction(instr)},rest);

emit_instruction({fn_id,rule_id,op,tp}) -> emit_instruction({fn_id,rule_id,op,tp,0,0,0,0,0,0});
emit_instruction({fn_id,rule_id,op,tp,flags_dst,dst}) -> emit_instruction({fn_id,rule_id,op,tp,flags_dst,dst,0,0,0,0});
emit_instruction({fn_id,rule_id,op,tp,flags_dst,dst,flags_src1,src1}) -> emit_instruction({fn_id,rule_id,op,tp,flags_dst,dst,flags_src1,src1,0,0});
emit_instruction({fn_id,rule_id,op,tp,flags_dst,dst,flags_src1,src1,flags_src2,src2}) ->
    {op,tp,*emitb(2,{},fn_id),rule_id&255,flags_dst&255,flags_src1&255,flags_src2&255,*emitb(4,{},dst),*emitb(4,{},0),*emitb(8,{},src1),*emitb(8,{},src2)};
emit_instruction({fn_id,rule_id,op,tp,flags_dst,dst,flags_src1,src1,flags_src2,src2,lbl2}) ->
    {op,tp,*emitb(2,{},fn_id),rule_id&255,flags_dst&255,flags_src1&255,flags_src2&255,*emitb(4,{},dst),*emitb(4,{},lbl2),*emitb(8,{},src1),*emitb(8,{},src2)};

emitb(0,sofar,_) -> sofar;
emitb(n,sofar,v) -> emitb(n-1,{*sofar,v&255},v>>8);

///////////////////////////////////////////////////////////
// LLVM
///////////////////////////////////////////////////////////

minify_table(sofar,{}) -> sofar;
minify_table(sofar,{{_,fnlineno,symoffset,name,reg_count1,bitmask1,type_left,reg_count2,bitmask2,type_right},*rest}) ->
    minify_table({*sofar,{name,fnlineno,symoffset,min(length(type_left),8)}},rest);

ll_boilerplate() -> {
    ';File generated by ReWrite compiler 0.0.7. Please do not alter.\n',
    'target datalayout="e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"\n',
    'target triple="x86_64-pc-linux-gnu"\n',
    '%R8=type{i64,i64,i64,i64,i64,i64,i64,i64}\n',
    '%struct.VMContext=type{i64,i32,i32,i32,i32,ptr,ptr}\n',
    'declare i32 @setjmp(ptr) #0\n',
    'declare void @__rw__error(ptr,i32,i32,i32,ptr) noreturn\n\n',
    '@.fn.syms=private unnamed_addr constant['
};

ll_boilerplate_end() -> "\nattributes #0={returns_twice}\n";

convert_to_llvm(target,small_table,table,symtext,symsz,sofar,{}) -> {*ll_boilerplate(),*int_to_string(symsz),'x i8] c"',*symtext,'"\n',*sofar};
convert_to_llvm(target,small_table,table,symtext,symsz,sofar,{{fnid,code},*rest}) ->
    convert_to_llvm(target,small_table,table,symtext,symsz,{*sofar,*convert_to_ll_fn(target,small_table,table,fnid,code)},rest);

convert_to_ll_fn(target,small_table,table,fnid,code) ->
    match nth(fnid,table) => {_,_,_,name,reg_count1,bitmask1,type_left,reg_count2,bitmask2,type_right} ->
    {'\ndefine x86_regcallcc %R8 @__rw.',*name,'(i64 %s0,i64 %s1,i64 %s2,i64 %s3,i64 %s4,i64 %s5,i64 %s6,i64 %s7, ptr %A) {\nentry:\n',
    *ll_write_alloca(0,min(max(length(type_left),length(type_right)),8),{}),
    *ll_write_store_param(0,min(length(type_left),8),{}),
    '\tbr label %L',*int_to_string36(fnid),'\n',
    *ll_emit_instructions(small_table,{},code),
    'exit:\n',
    *ll_build_epilog1(0,min(length(type_right),8),{}),
    *ll_build_epilog2(0,min(length(type_right),8),{}),
    *ll_ret(min(length(type_right),8)),
    '}\n'};

ll_write_alloca(n,n,sofar) -> sofar;
ll_write_alloca(i,n,sofar) -> ll_write_alloca(i+1,n,{*sofar,'\t%x','0'+i,'=alloca i64\n'});

ll_write_store_param(n,n,sofar) -> sofar;
ll_write_store_param(i,n,sofar) -> ll_write_store_param(i+1,n,{*sofar,'\tstore i64 %s','0'+i,',ptr %x','0'+i,'\n'});

ll_build_epilog1(n,n,sofar) -> sofar;
ll_build_epilog1(i,n,sofar) -> ll_build_epilog1(i+1,n,{*sofar,'\t%p','0'+i,'=load i64,ptr %x','0'+i,'\n'});

ll_build_epilog2(n,n,sofar) -> sofar;
ll_build_epilog2(0,n,sofar) -> ll_build_epilog2(1,n,{*sofar,'\t%m0=insertvalue %R8 undef,i64 %p0,0\n'});
ll_build_epilog2(i,n,sofar) -> ll_build_epilog2(i+1,n,{*sofar,'\t%m','0'+i,'=insertvalue %R8 %m','0'+i-1,',i64 %p','0'+i,',','0'+i,'\n'});

ll_ret(0) -> {'\tret %R8 undef\n'};
ll_ret(n) -> {'\tret %R8 %m','0'+n-1,'\n'};

ll_emit_instructions(table,sofar,{}) -> sofar;
ll_emit_instructions(table,sofar,{instr,*rest}) -> ll_emit_instructions(table,{*sofar,*add_newline(ll_emit_instruction(table,instr))},rest);

add_newline("") -> "";
add_newline(str) -> {*str,'\n'};

ll_emit_instruction(_,{_,_,OpLabel,_,_,dst}) ->{'L',*int_to_string36(dst),':'};
ll_emit_instruction(_,{_,_,OpRet,_}) -> "\tbr label %exit";
ll_emit_instruction(_,{_,_,OpAddStack,_,_,_,_,_}) -> "";
ll_emit_instruction(_,{_,_,op,_,BindReg,dst,BindArgRet,src,*_}) when op>=OpMove when op<OpMove+5 -> {'\t%t',*int_to_string36(dst),'=load ',*intsize(op-OpMove),',',*ll_emit_arg(BindArgRet,src)};
ll_emit_instruction(_,{_,_,op,_,BindArgRet,dst,flag_src,src,*_}) when op>=OpMove when op<OpMove+5 -> {'\tstore ',*intsize(op-OpMove),' ',*ll_emit_arg(flag_src,src),',ptr %x','0'+dst};
ll_emit_instruction(_,{_,_,op,_,BindArgRet,dst,flag_src,src,_,off}) when op>=OpInsert when op<OpInsert+5 ->
    {'\tstore ',*intsize(op-OpInsert),' ',*ll_emit_arg(flag_src,src),',ptr %x','0'+dst,'\n\t%a',*int_to_string36(dst+off),'=load ',*intsize(op-OpInsert),',ptr %x','0'+dst};
ll_emit_instruction(_,{_,_,op,_,BindReg,dst,BindArgRet,src,_,off}) when op>=OpExtract when op<OpExtract+5 -> {'\t',*ll_emit_arg(BindReg,dst),'=extractvalue %R8 %z',*int_to_string36(off),',',*int_to_string(src)};
ll_emit_instruction(_,{_,_,op,_,_,lbl,flag_src,src,flag_src2,src2,lbl2}) when op>=OpCompareNotEqualBranch when op<OpCompareNotEqualBranch+5 -> match int_to_string36(lbl2) => id ->
    {'\t%c',*id,'=icmp ne ',*intsize(op-OpCompareNotEqualBranch),' ',*ll_emit_arg(flag_src,src),',',*ll_emit_arg(flag_src2,src2),'\n\tbr i1 %c',*id,',label %L',*int_to_string36(lbl),',label %L',*id};
ll_emit_instruction(_,{_,_,op,tp,BindReg,dst,flag_src,src,flag_src2,src2}) when op>=OpPlus when op<=OpMod ->
    {'\t',*ll_emit_arg(BindReg,dst),'=',*ll_binop(op,tp),' ',*ll_emit_arg(flag_src,src),',',*ll_emit_arg(flag_src2,src2)};
ll_emit_instruction(table,{_,_,OpCall,_,_,label,_,_,_,off}) -> match nth(label,table) => {name,_,_,arity} ->
    {'\t%z',*int_to_string36(off),'=call x86_regcallcc %R8 @__rw.',*name,'(',*output_lbls({},off,arity+off),*output_undef({},arity,8),'ptr %A)'};
ll_emit_instruction(table,{_,off,OpGoto,_,_,label}) -> match nth(label,table) => {name,_,_,arity} ->
    {'\t%q',*int_to_string36(off),'=musttail call x86_regcallcc %R8 @__rw.',*name,'(',*output_lbls({},off,arity+off),*output_undef({},arity,8),'ptr %A)\n\tret %R8 %q',*int_to_string36(off)};
ll_emit_instruction(_,{_,_,OpError,code,_,line,_,sym}) ->
    {'\tcall void @__rw__error(ptr %A,i32 ',*int_to_string(code),',i32 ',*int_to_string(line),',i32 ',*int_to_string(sym),',ptr @.fn.syms)\n\tunreachable\n'};
ll_emit_instruction(_,{_,_,op,*_}) -> {'\tunknown:',*int_to_string(op)};

output_lbls(sofar,n,n) -> sofar;
output_lbls(sofar,i,n) -> output_lbls({*sofar,'i64 %a',*int_to_string36(i),','},i+1,n);

output_undef(sofar,n,n) -> sofar;
output_undef(sofar,i,n) -> output_undef({*sofar,'i64 undef,'},i+1,n);

ll_emit_arg(BindArgRet,src) -> {'ptr %x','0'+src};
ll_emit_arg(BindReg,src) -> {'%t',*int_to_string36(src)};
ll_emit_arg(BindImm,src) -> int_to_string(src);

ll_binop(OpPlus,tp) -> {'add ',*ll_tp(tp)};
ll_binop(OpMinus,tp) -> {'sub ',*ll_tp(tp)};
ll_binop(OpTimes,tp) -> {'mul ',*ll_tp(tp)};
ll_binop(OpDiv,tp) when is_unsigned(tp) -> {'udiv ',*ll_tp(tp)};
ll_binop(OpDiv,tp) -> {'sdiv ',*ll_tp(tp)};
ll_binop(OpMod,tp) when is_unsigned(tp) -> {'urem ',*ll_tp(tp)};
ll_binop(OpMod,tp) -> {'srem ',*ll_tp(tp)};

is_unsigned(_) -> false;

ll_tp(TypeI64) -> "i64";

intsize(3) -> "i64";

///////////////////////////////////////////////////////////
// C FFI
///////////////////////////////////////////////////////////

to_upper_sanitize(sofar,{}) -> sofar;
to_upper_sanitize(sofar,{c,*rest}) -> to_upper_sanitize({*sofar,to_upper_sanitize_aux(c)},rest);

to_upper_sanitize_aux(c) when c>='a' when c<='z' -> c-32;
to_upper_sanitize_aux(c) when (c>='A' && c<='Z') || (c>='0' && c<='9') -> c;
to_upper_sanitize_aux(c) -> '_';

save_c_header(target,outfile,content) ->
    match to_upper_sanitize({},outfile) => file_upper ->
    save_text_file({*outfile,'.h'},
        {'#ifndef RW_',*file_upper,'_H\n#define RW_',*file_upper,'_H\n#include "',*includes(target),'"\n\n',
        '#ifdef __cplusplus\nnamespace ',*outfile,' {\nextern "C" {\n#endif\n',
        *content,
        '\n#ifdef __cplusplus\n}\n}\n#endif\n\n#endif\n'});

includes(TargetVM) -> "vm.h";
includes(TargetVMLL) -> "vm.h";
includes(_) -> "rewrite_base.h";

create_export_wrappers_vm(target,sofarc,sofarh,_,_,{}) -> sofarc,sofarh;
create_export_wrappers_vm(target,sofarc,sofarh,fnid,label_id,{{false,*_},*rest}) -> create_export_wrappers_vm(target,sofarc,sofarh,fnid+1,label_id,rest);
create_export_wrappers_vm(target,sofarc,sofarh,fnid,label_id,{{_,_,_,name,_,_,left,_,_,right},*rest}) ->
    match label_id+1 => new_lbl ->
    create_export_wrappers_vm(target,
        {*sofarc,
        {new_lbl,{{new_lbl,0,OpLabel,0,BindLabel,new_lbl},
            *create_export_vm_code_in(new_lbl,0,{},left),
            {new_lbl,0,OpCall,0,BindLabel,fnid,0,2,0,0},
            {new_lbl,0,OpAddStack,0,0,0,0,-2},
            *create_export_vm_code_out(new_lbl,0,{},right),
            {new_lbl,0,OpRet,0}}}},
        {*sofarh,'\nstatic inline int32_t rw_',*name,'(RWInstance* a',*create_export_vm_sigc({},0,"in",left),*create_export_vm_sigc({},0,"*out",right),') {\n',
            '\tuint64_t inout[',*int_to_string(max(length(left),length(right))),']={',*create_export_vm_in({},0,left),'};\n',
            '\tint32_t e=RW__vmcall(a,',*int_to_string(new_lbl),',inout);\n\tif(e!=0)return e;\n',
            *create_export_vm_out({},0,right),
            '\treturn 0;\n}\n'},
        fnid+1,new_lbl,rest);

create_export_vm_code_in(_,_,sofar,{}) -> sofar;
create_export_vm_code_in(new_lbl,n,sofar,{{regs,tp},*rest}) -> create_export_vm_code_in(new_lbl,n+1,{*sofar,*create_export_vm_param(new_lbl,n,tp,regs)},rest);

create_export_vm_code_out(_,_,sofar,{}) -> sofar;
create_export_vm_code_out(new_lbl,n,sofar,{{regs,tp},*rest}) -> create_export_vm_code_out(new_lbl,n+1,{*sofar,*create_export_vm_ret(new_lbl,n,tp,regs)},rest);

create_export_vm_param(new_lbl,n,tp,{{flag,dst}}) -> {{new_lbl,0,OpMove+get_scalar_type_size(tp),0,flag,dst,BindInOut,n}};

create_export_vm_ret(new_lbl,n,tp,{{flag,dst}}) -> {{new_lbl,0,OpMove+get_scalar_type_size(tp),0,BindInOut,n,flag,dst}};

create_export_vm_sigc(sofar,_,_,{}) -> sofar;
create_export_vm_sigc(sofar,n,fill,{{_,tp},*rest}) -> create_export_vm_sigc({*sofar,',',*c_type(tp),' ',*fill,*int_to_string36(n)},n+1,fill,rest);

c_type(TypeI64) -> "int64_t";
c_type(TypeBool) -> "bool";

create_export_vm_in(sofar,_,{}) -> sofar;
create_export_vm_in(sofar,n,{{_,tp},*rest}) -> create_export_vm_in({*sofar,'(uint64_t)in',*int_to_string36(n),','},n+1,rest);

create_export_vm_out(sofar,_,{}) -> sofar;
create_export_vm_out(sofar,n,{{_,tp},*rest}) ->
    create_export_vm_out({*sofar,'\t*out',*int_to_string36(n),'=(',*c_type(tp),')inout[',*int_to_string36(n),'];\n'},n+1,rest);

create_export_wrappers_ll(target,sofarc,sofarh,_,{}) -> sofarc,sofarh;
create_export_wrappers_ll(target,sofarc,sofarh,fnid,{{false,*_},*rest}) -> create_export_wrappers_ll(target,sofarc,sofarh,fnid+1,rest);
create_export_wrappers_ll(target,sofarc,sofarh,fnid,{{_,_,_,name,_,_,left,_,_,right},*rest}) ->
    match create_export_ll_sigc_in({},{},0,left) => inparams,inregs
    match create_export_ll_pre_call({},{},inregs) => pre,inregs2 ->
    create_export_wrappers_ll(target,
        {*sofarc,
        '\ndefine i32 @rw_',*name,'(ptr %A',*inparams,*create_export_ll_sigc_out({},0,length(right)),') {\n',
        'entry:\n',
        *pre,
        '\t%jump_buf_slot = getelementptr inbounds %struct.VMContext,ptr %A,i32 0,i32 6\n',
        '\t%jump_target_ptr = load ptr, ptr %jump_buf_slot, align 8\n',
        '\t%status = call i32 @setjmp(ptr %jump_target_ptr)\n',
        '\t%is_initial = icmp eq i32 %status, 0\n',
        '\tbr i1 %is_initial, label %body, label %fail\n',
        'body:\n',
        '\t%z=call x86_regcallcc %R8 @__rw.',*name,'(',*create_export_ll_params({},inregs2),*output_undef({},length(left),8),'ptr %A)\n',
        *create_export_ll_post_call({},0,right),
        '\tret i32 0\n',
        'fail:\n',
        '\tret i32 %status\n',
        '}\n'},
        {*sofarh,'\nint32_t rw_',*name,'(RWInstance* a',*create_export_vm_sigc({},0,"in",left),*create_export_vm_sigc({},0,"*out",right),');\n'},
        fnid+1,rest);

create_export_ll_sigc_in(sofar,regs,_,{}) -> sofar,regs;
create_export_ll_sigc_in(sofar,regs,n,{{_,tp},*rest}) -> match {'in',*int_to_string36(n)} => reg ->
    create_export_ll_sigc_in({*sofar,',',*ll_tp(tp),' %',*reg},{*regs,{reg,tp}},n+1,rest);

create_export_ll_sigc_out(sofar,n,n) -> sofar;
create_export_ll_sigc_out(sofar,i,n) -> create_export_ll_sigc_out({*sofar,',ptr %out',*int_to_string36(i)},i+1,n);

create_export_ll_pre_call(code,reglist,{}) -> code,reglist;
create_export_ll_pre_call(code,reglist,{{reg,tp},*rest}) match get_type_size_pri(tp) => {_,8} -> create_export_ll_pre_call(code,{*reglist,reg},rest);

create_export_ll_params(sofar,{}) -> sofar;
create_export_ll_params(sofar,{reg,*rest}) -> create_export_ll_params({*sofar,'i64 %',*reg,','},rest);

create_export_ll_post_call(code,_,{}) -> code;
create_export_ll_post_call(code,n,{{reg,tp},*rest}) match get_type_size_pri(tp) => {_,8} ->
    match int_to_string36(n) => ni ->
    create_export_ll_post_call({*code,'\t%eo',*ni,'=extractvalue %R8 %z,',*int_to_string(n),'\n\tstore i64 %eo',*ni,',ptr %out',*ni,'\n'},n+1,rest);
