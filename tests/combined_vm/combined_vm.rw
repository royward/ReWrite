// Combined VM only examples to make testing easier
// NOTE: this will disappear as the native versions can do anything the VM version can
// SPDX-License-Identifier: CC0-1.0

:- g() -> char,char;
g() -> 'cd';

:- export f() -> i64,value string, value string;
f() -> 0,{'ab',g()},"test";

:- export h(value string, value string, i64) -> value string, char;
h(s,{_,a,'x'},0) -> s,a;

:- export cdr(value string) -> value string;
cdr({a,*rest}) -> rest;

:- export len(value string) -> i64;
len("") -> 0;
len({a,*rest}) -> len(rest)+1;

:- export member(char, value string) -> bool;
member(_,{}) -> false;
member(x,{x,*_}) -> true;
member(x,{_,*rest}) -> member(x,rest);

:- temp() -> bool;
temp() -> member('a',"abc");

:- export listn2(i64) -> value string;
listn2(n) -> listn_aux(0,n,{});

:- listn_aux(i64,i64,string) -> string;
listn_aux(n,n,sofar) -> sofar;
//listn_aux(n,m,sofar) -> listn_aux(n+1,m,{*sofar,'a'+n});
