:- export swap(i64,i64) -> i64,i64;
swap(x,y) -> y,x;

:- export multiret(i64,i64) -> i64;
multiret(a,b) -> sub(swap(a,b))+1;

:- sub(i64,i64) -> i64;
sub(a,b) -> a-b;

:- wildcard_test0(i64,i64) -> i64;
wildcard_test0(a,b) -> 3;

:- wildcard_test1(i64,i64) -> i64;
wildcard_test1(_,_) -> 3;

:- neg(bool) -> bool;
neg(false) -> true;
neg(true) -> false;

