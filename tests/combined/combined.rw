:- export swap(i64,i64) -> i64,i64;
swap(x,y) -> y,x;

:- sub(i64,i64) -> i64;
sub(a,b) -> a-b;

:- export multiret(i64,i64) -> i64;
multiret(a,b) -> sub(swap(a,b))+1;

:- wildcard_test0(i64,i64) -> i64;
wildcard_test0(a,b) -> 3;

:- wildcard_test1(i64,i64) -> i64;
wildcard_test1(_,_) -> 3;

:- export neg(bool) -> bool;
neg(false) -> true;
neg(true) -> false;

:- validate(i64) -> bool,i64;
validate(x) when x>=0 -> true, x*2;
validate(_) -> false, 0;

:- allsame(i64,i64,i64,i64) -> bool;
allsame(n,n,n,n) -> true;

:- export break_rhs(i64) -> i64;
break_rhs(x) -> when x>=0 -> x*3;
break_rhs(x) -> x*2;

:- export break_rhs2(i64,i64) -> i64;
break_rhs2(n,x) -> match x=>n -> x*3;
break_rhs2(n,x) -> x*2;

:- export process(i64) -> i64;
process(x) match validate(x) => true,data -> data;
process(_) -> #error(10);

:- expensive(i64) -> i64;
expensive(n) -> n+n+n;

:- export use_twice(i64) -> i64;
use_twice(n) -> match expensive(n) => result -> result*result;

:- export noparam() -> i64;
noparam() -> 3;
