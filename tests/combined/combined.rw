// Combined examples to make running tests easier
// SPDX-License-Identifier: CC0-1.0

export fn fact(n:i64)->i64;
fact(0)->1;
fact(n)->n*fact(n-1);

export fn equal(i64,i64) -> bool;
equal(x,x) -> true;
equal(_,_) -> false;

export fn min_max(i64,i64) -> i64,i64;
min_max(a,b) when a<b -> a,b;
min_max(a,b) -> b,a;

export fn clamp(i64,i64,i64) -> i64;
clamp(x,lo,hi)
    update min_max(lo,hi) => lo,hi
    update min_max(x,lo) => _,x
    update min_max(x,hi) => x,_ ->
    x;

const TokNumber = 1;
const TokPlus = 2;
const TokMinus = 3;
const TokEof = 0;

export fn eval(op:i64,i64,i64) -> i64;
eval(TokNumber, a, _) -> a; // just return the first one
eval(TokPlus, a, b) -> a+b;
eval(TokMinus, a, b) -> a-b;
eval(TokEof, _, _) -> TokEof;

export fn fact2(n:i64)->i64;
fact2(n) when n>0 -> n*fact2(n-1);
fact2(_) -> 1;

const ErrNegUnexpected = 88;

export fn fact_err(n:i64)->i64;
fact_err(n) when n<0 -> #error(ErrNegUnexpected);
fact_err(0)->1;
fact_err(n)->n*fact_err(n-1);

export fn fact_tail(value n:i64) -> value i64;
fact_tail(n) -> fact_aux(1,n);

fn fact_aux(i64,i64) -> i64;
fact_aux(acc,0) -> acc;
fact_aux(acc,n) -> fact_aux(acc*n,n-1);

export fn fib(n:i64)->i64;
fib(0) -> 1;
fib(1) -> 1;
fib(n) -> fib(n-2)+fib(n-1);

export fn swap(value i64,i64) -> i64,value i64;
swap(x,y) -> y,x;

fn sub(i64,i64) -> i64;
sub(a,b) -> a-b;

export fn multiret(i64,i64) -> i64;
multiret(a,b) -> sub(swap(a,b))+1;

fn wildcard_test0(i64,i64) -> i64;
wildcard_test0(a,b) -> 3;

fn wildcard_test1(i64,i64) -> i64;
wildcard_test1(_,_) -> 3;

export fn neg(bool) -> bool;
neg(false) -> true;
neg(true) -> false;

fn validate(i64) -> bool,i64;
validate(x) when x>=0 -> true, x*2;
validate(_) -> false, 0;

fn allsame(i64,i64,i64,i64) -> bool;
allsame(n,n,n,n) -> true;

export fn break_rhs(i64) -> i64;
break_rhs(x) match x>=0 => true -> x*3;
break_rhs(x) -> x*2;

export fn break_rhs2(i64,i64) -> i64;
break_rhs2(n,x) match x=>n -> x*3;
break_rhs2(n,x) -> x*2;

export fn process(i64) -> i64;
process(x) @match validate(x) => true,data -> data;
process(_) -> #error(10);

fn expensive(i64) -> i64;
expensive(n) -> n+n+n;

export fn use_twice(i64) -> i64;
use_twice(n) match expensive(n) => result -> result*result;

export fn noparam() -> i64;
noparam() -> 3;

export fn to_uppercase(char) -> char;
to_uppercase(c) when c>='a' when c<='z' -> c-32;
to_uppercase(c) -> c;
