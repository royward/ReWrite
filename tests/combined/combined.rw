:- export fact(n:i64)->i64;
fact(0)->1;
fact(n)->n*fact(n-1);

:- export equal(i64,i64) -> bool;
equal(x,x) -> true;
equal(_,_) -> false;

:- export min_max(i64,i64) -> i64,i64;
min_max(a,b) when a<b -> a,b;
min_max(a,b) -> b,a;

:- export clamp(i64,i64,i64) -> i64;
clamp(x,lo,hi) ->
    update min_max(lo,hi) => lo,hi
    update min_max(x,lo) => _,x
    update min_max(x,hi) => x,_ ->
    x;

const TokNumber = 1;
const TokPlus = 2;
const TokMinus = 3;
const TokEof = 0;

:- export eval(op:i64,i64,i64) -> i64;
eval(TokNumber, a, _) -> a; // just return the first one
eval(TokPlus, a, b) -> a+b;
eval(TokMinus, a, b) -> a-b;
eval(TokEof, _, _) -> TokEof;

:- export fact2(n:i64)->i64;
fact2(n) when n>0 -> n*fact2(n-1);
fact2(_) -> 1;

const ErrNegUnexpected = 88;

:- export fact_err(n:i64)->i64;
fact_err(n) when n<0 -> #error(ErrNegUnexpected);
fact_err(0)->1;
fact_err(n)->n*fact_err(n-1);

:- export fact_tail(n:i64) -> i64;
fact_tail(n) -> fact_aux(1,n);

:- fact_aux(i64,i64) -> i64;
fact_aux(acc,0) -> acc;
fact_aux(acc,n) -> fact_aux(acc*n,n-1);

:- export fib(n:i64)->i64;
fib(0) -> 1;
fib(1) -> 1;
fib(n) -> fib(n-2)+fib(n-1);

